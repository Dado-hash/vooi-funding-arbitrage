# Copia in .env e compila. .env è in .gitignore.
VOOI_MCP_URL=https://perps-api.vooi.io/mcp
VOOI_MCP_TOKEN=
# Header e schema usati per il token. Copiali dalla config MCP di Claude Code
# (`claude mcp get vooi-perps`). Se il token va passato senza schema, lascia vuoto.
VOOI_MCP_AUTH_HEADER=Authorization
VOOI_MCP_AUTH_SCHEME=Bearer

# Telegram (solo invio): token da @BotFather, chat id da `uv run arb tg chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# notify  = Claude manda analisi e istruzioni, tu operi su VOOI (default)
# execute = proposte con Approva/Rifiuta su Telegram, Claude esegue via MCP dopo il tap
TRADING_MODE=notify

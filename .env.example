# Copy to .env and fill in. .env is in .gitignore.
VOOI_MCP_URL=https://perps-api.vooi.io/mcp
VOOI_MCP_TOKEN=
# Header and scheme used for the token. Copy them from your VOOI MCP setup. If you run the agent
# through Claude Code, `claude mcp get vooi-perps` shows the configured header (leave empty if the
# token must be passed without a scheme).
VOOI_MCP_AUTH_HEADER=Authorization
VOOI_MCP_AUTH_SCHEME=Bearer

# Telegram (sending and button approvals): token from @BotFather, chat id from `uv run arb tg chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# notify  = the agent sends analysis and instructions, you operate on VOOI (default)
# execute = proposals with Approve/Reject buttons on Telegram; the agent executes via MCP after the tap
TRADING_MODE=notify
